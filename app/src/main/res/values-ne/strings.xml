    <!-- Help center -->
    <string name="help_faq_title">बारम्बार सोधिने प्रश्नहरू</string>
    <string name="faq_profile_q">आफ्नो नाम वा विवरण कसरी परिवर्तन गर्ने?</string> <!-- review -->
    <string name="faq_profile_a">प्रोफाइलमा गएर \"प्रोफाइल सम्पादन गर्नुहोस्\" थिच्नुहोस्। त्यहाँ नाम परिवर्तन गर्न र मोबाइल नम्बर, जन्म मिति र लिङ्ग थप्न वा हटाउन सकिन्छ।</string>
    <string name="faq_password_q">पासवर्ड कसरी परिवर्तन गर्ने?</string> <!-- review -->
    <string name="faq_password_a">प्रोफाइलमा गएर \"पासवर्ड परिवर्तन गर्नुहोस्\" थिच्नुहोस्। पहिले हालको पासवर्ड, अनि नयाँ पासवर्ड प्रविष्ट गर्नुहोस्। Google बाट लगइन गर्नुहुन्छ भने आफ्नो Google खातामा पासवर्ड व्यवस्थापन गर्नुहोस्।</string>
    <string name="faq_appearance_q">के म अँध्यारो थिम वा नेपाली भाषा प्रयोग गर्न सक्छु?</string> <!-- review -->
    <string name="faq_appearance_a">सक्नुहुन्छ। प्रोफाइलको \"थिम र भाषा\" भागमा थिमका लागि सिस्टम अनुसार, उज्यालो वा अँध्यारो, र भाषाका लागि अंग्रेजी वा नेपाली छान्नुहोस्।</string>
    <string name="faq_data_q">मेरो डेटा कहाँ राखिन्छ?</string> <!-- review -->
    <string name="faq_data_a">तपाईंको खाता र प्रोफाइल Google Firebase (Authentication र Cloud Firestore) मा राखिन्छ। एपले तपाईंको पासवर्ड कहिल्यै राख्दैन; लगइन Firebase ले सम्हाल्छ। थप जानकारीका लागि गोपनीयता नीति हेर्नुहोस्।</string> <!-- review -->
    <string name="faq_delete_q">खाता कसरी मेटाउने?</string> <!-- review -->
    <string name="faq_delete_a">प्रोफाइलको \"खाता मेटाउने\" भागमा गएर \"खाता मेटाउनुहोस्\" थिच्नुहोस्। पुष्टि गर्न सोधिनेछ। यसले तपाईंको प्रोफाइल र खाता स्थायी रूपमा हटाउँछ।</string>
    <string name="faq_coming_q">मेरा स्वास्थ्य रेकर्ड कहाँ छन्?</string> <!-- review -->
    <string name="faq_coming_a">ती छिट्टै आउँदैछन्। त्यो सुविधा बनेपछि रेकर्ड ट्याबमा देखिनेछन्।</string> <!-- review -->

