    <string name="legal_draft_banner">मस्यौदा: विद्यार्थी परियोजनाका लागि अस्थायी पाठ। कुनै पनि सार्वजनिक प्रकाशनअघि यसलाई बदल्नुपर्छ।</string> <!-- review -->
    <string name="privacy_what_title">हामी के राख्छौं</string> <!-- review -->
    <string name="privacy_what_body">तपाईंको नाम, इमेल ठेगाना र खाताको भूमिका। तपाईंले थप्नुभएमा मोबाइल नम्बर, जन्म मिति र लिङ्ग पनि।</string> <!-- review -->
    <string name="privacy_where_title">कहाँ राखिन्छ</string> <!-- review -->
    <string name="privacy_where_body">Google Firebase मा: लगइनका लागि Firebase Authentication र प्रोफाइलका लागि Cloud Firestore। एप अफलाइन चलोस् भनेर प्रोफाइलको एक प्रति तपाईंको फोनमा राखिन्छ; लगआउट गर्दा यो हटाइन्छ।</string> <!-- review -->
    <string name="privacy_passwords_title">पासवर्ड</string>
    <string name="privacy_passwords_body">एपले तपाईंको पासवर्ड कहिल्यै राख्दैन। यो Firebase ले सम्हाल्छ। तपाईंले अनुमति दिनुभयो भने फोनको पासवर्ड म्यानेजरले यसलाई सुरक्षित गर्न सक्छ।</string> <!-- review -->
    <string name="privacy_sharing_title">साझेदारी</string> <!-- review -->
    <string name="privacy_sharing_body">तपाईंको डेटा कसैलाई बेचिँदैन वा साझा गरिँदैन। यो यस एपमा तपाईंको खाता चलाउन मात्र प्रयोग हुन्छ।</string> <!-- review -->
    <string name="privacy_delete_title">आफ्नो डेटा मेटाउने</string> <!-- review -->
    <string name="privacy_delete_body">प्रोफाइलको \"खाता मेटाउने\" भागमा गएर \"खाता मेटाउनुहोस्\" थिच्नुहोस्। यसले तपाईंको प्रोफाइल र खाता स्थायी रूपमा मेटाउँछ।</string>
    <string name="terms_project_title">विद्यार्थी परियोजना</string> <!-- review -->
    <string name="terms_project_body">MedHome सिकाइका लागि बनाइएको विद्यार्थी परियोजना हो। यो जस्तो छ त्यस्तै, कुनै ग्यारेन्टीबिना उपलब्ध गराइएको छ।</string> <!-- review -->
    <string name="terms_medical_title">चिकित्सकीय सल्लाह होइन</string> <!-- review -->
    <string name="terms_medical_body">MedHome ले चिकित्सकीय सल्लाह दिँदैन र यो चिकित्सा उपकरण होइन। स्वास्थ्य समस्याका लागि सधैं योग्य स्वास्थ्यकर्मीसँग सम्पर्क गर्नुहोस्। आपतकालमा स्थानीय आपतकालीन नम्बरमा फोन गर्नुहोस्।</string> <!-- review -->
    <string name="terms_account_title">तपाईंको खाता</string> <!-- review -->
    <string name="terms_account_body">आफ्नो लगइन विवरण गोप्य राख्नुहोस्। प्रोफाइलबाट जुनसुकै बेला खाता मेटाउन सक्नुहुन्छ।</string> <!-- review -->
    <string name="terms_changes_title">परिवर्तनहरू</string> <!-- review -->
    <string name="terms_changes_body">एपको विकाससँगै यी सर्तहरू परिवर्तन हुन सक्छन्।</string> <!-- review -->

