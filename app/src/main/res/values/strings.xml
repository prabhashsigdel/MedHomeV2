    <!-- Help center -->
    <string name="help_faq_title">Frequently asked questions</string>
    <string name="faq_profile_q">How do I change my name or details?</string>
    <string name="faq_profile_a">Go to Profile, then Edit profile. You can change your name and add or remove your mobile number, date of birth and gender.</string>
    <string name="faq_password_q">How do I change my password?</string>
    <string name="faq_password_a">Go to Profile, then Change password. Enter your current password, then your new one. If you sign in with Google, manage your password in your Google account instead.</string>
    <string name="faq_appearance_q">Can I use dark mode or Nepali?</string>
    <string name="faq_appearance_a">Yes. Go to Profile, then Appearance. Choose System, Light or Dark for the theme, and English or Nepali for the language.</string>
    <string name="faq_data_q">Where is my data stored?</string>
    <string name="faq_data_a">Your account and profile are stored with Google Firebase (Authentication and Cloud Firestore). The app never stores your password; Firebase handles sign-in. See the privacy policy for details.</string>
    <string name="faq_delete_q">How do I delete my account?</string>
    <string name="faq_delete_a">Go to Profile, then Danger zone, and tap Delete account. You\'ll be asked to confirm. This permanently removes your profile and your account.</string>
    <string name="faq_coming_q">Where are my health records?</string>
    <string name="faq_coming_a">They\'re coming soon. The Records tab will fill in once that feature is built.</string>

    <!-- Privacy policy and terms: DRAFT placeholders for a student project -->
    <string name="legal_draft_banner">Draft: placeholder text for a student project. It must be replaced before any public release.</string>
    <string name="privacy_what_title">What we store</string>
    <string name="privacy_what_body">Your name, email address and account role. If you add them, also your mobile number, date of birth and gender.</string>
    <string name="privacy_where_title">Where it is stored</string>
    <string name="privacy_where_body">With Google Firebase: Firebase Authentication for your sign-in, and Cloud Firestore for your profile. A copy of your profile is kept on your phone so the app works offline; it is removed when you sign out.</string>
    <string name="privacy_passwords_title">Passwords</string>
    <string name="privacy_passwords_body">The app never stores your password. Firebase handles it. If you allow it, your phone\'s password manager can save it for you.</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing_body">Your data is not sold or shared with anyone. It is only used to run your account in this app.</string>
    <string name="privacy_delete_title">Deleting your data</string>
    <string name="privacy_delete_body">Go to Profile, then Danger zone, and tap Delete account. This permanently deletes your profile and your account.</string>
    <string name="terms_project_title">A student project</string>
    <string name="terms_project_body">MedHome is a student project made for learning. It is provided as is, without any guarantee.</string>
    <string name="terms_medical_title">Not medical advice</string>
    <string name="terms_medical_body">MedHome does not give medical advice and is not a medical device. For health concerns, always contact a qualified health professional. In an emergency, call your local emergency number.</string>
    <string name="terms_account_title">Your account</string>
    <string name="terms_account_body">Keep your sign-in details private. You can delete your account at any time from Profile.</string>
    <string name="terms_changes_title">Changes</string>
    <string name="terms_changes_body">These terms may change as the app develops.</string>

