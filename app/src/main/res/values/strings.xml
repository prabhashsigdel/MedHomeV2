    <string name="battery_status_off">Off</string>
    <string name="battery_samsung_title">Samsung</string>
    <string name="battery_samsung_steps">Open App info, tap Battery and choose Unrestricted. Then in Settings &gt; Battery &gt; Background usage limits, make sure MedHome isn\'t under Sleeping apps or Deep sleeping apps, and add it to Never sleeping apps.</string>
    <string name="battery_xiaomi_title">Xiaomi, Redmi and POCO</string>
    <string name="battery_xiaomi_steps">Turn on Autostart for MedHome. In App info &gt; Battery saver, choose No restrictions. You can also lock MedHome in recent apps (swipe down on it).</string>
    <string name="battery_other_title">Other phones</string>
    <string name="battery_other_steps">In Settings, find battery optimization (or App info &gt; Battery) and set MedHome to Unrestricted or Don\'t optimize.</string>
