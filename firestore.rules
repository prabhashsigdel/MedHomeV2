rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasValidName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
    }

    // Optional profile fields: each may be absent; if present it must be well formed.
    // Must match Validators.normalizePhone (Nepali mobile: 10 digits starting 96, 97 or 98).
    function hasValidPhone() {
      return !('phone' in request.resource.data)
        || (request.resource.data.phone is string
          && request.resource.data.phone.matches('9[678][0-9]{8}'));
    }

    // ISO calendar date "YYYY-MM-DD" (BirthDate in the app).
    function hasValidDateOfBirth() {
      return !('dateOfBirth' in request.resource.data)
        || (request.resource.data.dateOfBirth is string
          && request.resource.data.dateOfBirth.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // Stored as a fixed key, never as translated text.
    function hasValidGender() {
      return !('gender' in request.resource.data)
        || request.resource.data.gender in ['male', 'female', 'other'];
    }

    match /users/{uid} {
      // Own document only. Admins don't read profiles: a booking carries the name it was made under.
      allow read: if isOwner(uid);

      // Self-signup always creates a patient. createdAt must be the server timestamp.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && hasValidName()
        // Lowercased on both sides so a difference in letter case can't block profile creation.
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'patient'
        && request.resource.data.createdAt == request.time;

      // Owners may edit (or clear) name, phone, date of birth and gender, nothing else: never
      // their role, email or creation time. Admins may change only the role, to a known value.
      allow update: if (isOwner(uid)
          && changedKeys().hasOnly(['name', 'phone', 'dateOfBirth', 'gender'])
          && hasValidName()
          && hasValidPhone()
          && hasValidDateOfBirth()
          && hasValidGender())
        || (isAdmin()
          && changedKeys().hasOnly(['role'])
          && request.resource.data.role in ['patient', 'doctor', 'admin']);

      // Needed for in-app account deletion.
      allow delete: if isOwner(uid);
    }

    // ---- Doctors ----------------------------------------------------------------------------
    //
    // The doctors catalogue: signed-in users may read active doctors (a list must ask for
    // active == true); admins may read every doctor. isAdmin() is only evaluated for inactive or
    // missing doctors, so ordinary reads cost no extra document read.
    //
    // Admins (users/{uid}.role == 'admin', set by hand in the console) may add and edit doctors,
    // in full and well formed, with the same limits as the app's DoctorMapper and tools/seed.
    // Nobody deletes a doctor (bookings point at them): hiding is active == false. A document ID
    // can't change, so neither can a doctor's. The seed uses the Admin SDK, which bypasses this.

    // Letters, digits and hyphens, as Doctor.isValidId (no "_": slot IDs split on it).
    function isDoctorId(id) {
      return id is string && id.matches('[A-Za-z0-9-]{1,64}');
    }

    // Text exactly as DoctorMapper cleans it, so what is stored is what patients see and copy
    // into a booking (the booking rules compare the snapshot with the stored doctor): words of
    // visible characters (no control or invisible format characters, except the zero-width
    // joiners Devanagari needs) separated by single spaces, nothing before or after.
    function isLine(value, max) {
      return value is string
        && value.size() <= max
        && value.matches('([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+( ([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+)*');
    }

    // Like isLine, but lines may be broken, with at most one blank line between them (a bio).
    function isParagraph(value, max) {
      return value is string
        && value.size() <= max
        && value.matches('(([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+( ([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+)*)(\\n\\n?([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+( ([^\\p{Cc}\\p{Cf}\\p{Z}]|[\\x{200C}\\x{200D}])+)*)*');
    }

    function isWholeNumber(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    // {start, end}: "HH:mm", start before end ("HH:mm" strings sort like the times they name).
    function isRange(range) {
      return range is map
        && range.keys().hasOnly(['start', 'end'])
        && isClockTime(range.get('start', null))
        && isClockTime(range.get('end', null))
        && range.start < range.end;
    }

    // Two well-formed ranges that don't share a minute (touching is fine).
    function apart(a, b) {
      return a.end <= b.start || b.end <= a.start;
    }

    // At most 3 ranges (the app and booking rules read no more), each valid, none overlapping.
    function isDayHours(ranges) {
      return ranges is list
        && ranges.size() <= 3
        && (ranges.size() < 1 || isRange(ranges[0]))
        && (ranges.size() < 2 || (isRange(ranges[1]) && apart(ranges[0], ranges[1])))
        && (ranges.size() < 3 || (isRange(ranges[2]) && apart(ranges[0], ranges[2]) && apart(ranges[1], ranges[2])));
    }

    function isWeeklySchedule(schedule) {
      return schedule is map
        && schedule.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && isDayHours(schedule.get('sun', []))
        && isDayHours(schedule.get('mon', []))
        && isDayHours(schedule.get('tue', []))
        && isDayHours(schedule.get('wed', []))
        && isDayHours(schedule.get('thu', []))
        && isDayHours(schedule.get('fri', []))
        && isDayHours(schedule.get('sat', []));
    }

    // The whole doctor as it will be stored, stamped with who wrote it and when.
    function isValidDoctorWrite() {
      let doctor = request.resource.data;
      return doctor.keys().hasOnly(['name', 'specialty', 'hospital', 'feeNpr', 'experienceYears', 'bio',
          'slotMinutes', 'weeklySchedule', 'active', 'updatedAt', 'updatedBy'])
        && doctor.keys().hasAll(['name', 'specialty', 'hospital', 'feeNpr', 'experienceYears', 'bio',
          'slotMinutes', 'weeklySchedule', 'active', 'updatedAt', 'updatedBy'])
        && isLine(doctor.name, 100)
        && doctor.specialty in ['general_physician', 'cardiology', 'dermatology', 'pediatrics', 'gynecology',
          'orthopedics', 'ent', 'neurology', 'psychiatry', 'ophthalmology', 'dentistry', 'gastroenterology']
        && isLine(doctor.hospital, 120)
        && isWholeNumber(doctor.feeNpr, 0, 100000)
        && isWholeNumber(doctor.experienceYears, 0, 70)
        && isParagraph(doctor.bio, 2000)
        && isWholeNumber(doctor.slotMinutes, 5, 240)
        && isWeeklySchedule(doctor.weeklySchedule)
        && doctor.active is bool
        && doctor.updatedAt == request.time
        && doctor.updatedBy == request.auth.uid;
    }

    // Only `active` and the stamp change.
    function isActiveToggle() {
      return changedKeys().hasOnly(['active', 'updatedAt', 'updatedBy'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn() && (resource.data.active == true || isAdmin());
      // Admin writes also need a verified email (an admin's account is checked twice).
      allow create: if isDoctorId(doctorId) && emailVerified() && isAdmin() && isValidDoctorWrite();
      // Showing or hiding alone is checked on its own, so a doctor stored in an older or broken
      // shape (which patients' screens drop anyway) can still be hidden.
      allow update: if emailVerified() && isAdmin()
        && (isValidDoctorWrite() || isActiveToggle());
      allow delete: if false;
    }

    // ---- Booking ----------------------------------------------------------------------------
    //
    // A booking is three documents written in one transaction:
    //   bookings/{autoId}                         the patient's private record (history stays)
    //   slotLocks/{doctorId}_{yyyyMMdd}_{HHmm}    makes the slot unique; no personal data
    //   users/{uid}/bookingQuota/{1|2|3}          one of the patient's 3 upcoming-booking places
    // Each rule checks the others with getAfter(), so none can be written alone. Times in IDs
    // are Nepal time, a fixed UTC+05:45 (no daylight saving since 1986), as in the app.
    //
    // Cancelling is the same three documents: the booking turns cancelled (cancelledBy says by
    // whom), and its lock and quota place are deleted in the same write. The patient cancels
    // their own; an admin may cancel anyone's for the clinic, while it is upcoming, and nothing
    // else.

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function lockPath(slotId) {
      return /databases/$(database)/documents/slotLocks/$(slotId);
    }

    function quotaPath(uid, place) {
      return /databases/$(database)/documents/users/$(uid)/bookingQuota/$(string(place));
    }

    // Firestore auto IDs: never a path or anything longer.
    function isAutoId(id) {
      return id is string && id.matches('[A-Za-z0-9]{1,40}');
    }

    // After this write, quota place [place] of [uid] holds [bookingId].
    function holdsAfter(uid, place, bookingId) {
      return existsAfter(quotaPath(uid, place))
        && getAfter(quotaPath(uid, place)).data.bookingId == bookingId;
    }

    // An admin is cancelling [bookingId] for the clinic in this very write: booked before it,
    // cancelled by the clinic after it (the booking's own rule checks the rest).
    function isClinicCancelling(bookingId) {
      return isAutoId(bookingId)
        && get(bookingPath(bookingId)).data.status == 'booked'
        && getAfter(bookingPath(bookingId)).data.status == 'cancelled'
        && getAfter(bookingPath(bookingId)).data.cancelledBy == 'clinic'
        && emailVerified()
        && isAdmin();
    }

    // Wall-clock time in Nepal, as a timestamp whose UTC fields read as Nepal time.
    function nepalTime(t) {
      return t + duration.value(345, 'm');
    }

    // "HH:mm" -> minutes after midnight. Callers check the format first.
    function minutesOf(hhmm) {
      return int(hhmm[0:2]) * 60 + int(hhmm[3:5]);
    }

    function isClockTime(value) {
      return value is string && value.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }

    // {doctorId}_{yyyyMMdd}_{HHmm}, naming exactly this doctor and Nepal-time minute.
    function slotIdMatches(slotId, doctorId, startAt) {
      let parts = slotId.split('_');
      let local = nepalTime(startAt);
      return parts.size() == 3
        && parts[0] == doctorId
        && parts[1].matches('[0-9]{8}')
        && parts[2].matches('[0-9]{4}')
        && int(parts[1]) == local.year() * 10000 + local.month() * 100 + local.day()
        && int(parts[2]) == local.hours() * 100 + local.minutes()
        && startAt.seconds() == 0
        && startAt.nanos() == 0;
    }

    // A slot of [slotMinutes] starting at minute [m] fits [range] on its grid.
    function slotFits(range, m, slotMinutes) {
      return range is map
        && isClockTime(range.get('start', null))
        && isClockTime(range.get('end', null))
        && m >= minutesOf(range.start)
        && m + slotMinutes <= minutesOf(range.end)
        && (m - minutesOf(range.start)) % slotMinutes == 0;
    }

    // The doctor's own slot length, or 15 when missing or out of range (as DoctorMapper does).
    function slotMinutesOf(doctor) {
      let value = doctor.get('slotMinutes', 15);
      return value is int && value >= 5 && value <= 240 ? value : 15;
    }

    // startAt is one of the doctor's weekly slots. Up to 3 ranges a day, as the app reads them.
    function inSchedule(doctor, startAt) {
      let local = nepalTime(startAt);
      let dayKey = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'][local.dayOfWeek() - 1];
      let schedule = doctor.get('weeklySchedule', {});
      let ranges = schedule is map ? schedule.get(dayKey, []) : [];
      let m = local.hours() * 60 + local.minutes();
      let slotMinutes = slotMinutesOf(doctor);
      return ranges is list && (
        (ranges.size() > 0 && slotFits(ranges[0], m, slotMinutes))
        || (ranges.size() > 1 && slotFits(ranges[1], m, slotMinutes))
        || (ranges.size() > 2 && slotFits(ranges[2], m, slotMinutes)));
    }

    // The doctor is active, the snapshot copies their current details, and the time is theirs.
    function doctorAllows(booking) {
      // A missing doctor makes get() fail, which denies.
      let doctor = get(/databases/$(database)/documents/doctors/$(booking.doctorId)).data;
      return doctor.active == true
        && booking.doctor == {
          'name': doctor.name,
          'specialty': doctor.specialty,
          'hospital': doctor.hospital,
          'feeNpr': doctor.feeNpr
        }
        && inSchedule(doctor, booking.startAt);
    }

    match /bookings/{bookingId} {
      // Own bookings only (a list must ask for patientUid == your uid), or any booking for
      // admins (who may only cancel one for the clinic, below).
      allow read: if isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());

      // A new booking, with its slot lock and a quota place in the same write.
      allow create: if isSignedIn()
        && emailVerified()
        && isAutoId(bookingId)
        && request.resource.data.keys().hasOnly(['patientUid', 'patientName', 'doctorId', 'doctor', 'startAt', 'slotId', 'quotaPlace', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['patientUid', 'patientName', 'doctorId', 'doctor', 'startAt', 'slotId', 'quotaPlace', 'status', 'createdAt'])
        && request.resource.data.patientUid == request.auth.uid
        // The name the admin's list shows, so admins never read the profile itself.
        && request.resource.data.patientName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.status == 'booked'
        && request.resource.data.createdAt == request.time
        && request.resource.data.doctorId is string
        && request.resource.data.doctorId.matches('[A-Za-z0-9-]{1,64}')
        && request.resource.data.startAt is timestamp
        // At least 30 minutes ahead (the app offers slots an hour ahead; the margin allows
        // for a slow confirm and clock skew), so a slot can't be grabbed as it starts.
        && request.resource.data.startAt > request.time + duration.value(30, 'm')
        && request.resource.data.startAt < request.time + duration.value(15, 'd')
        && request.resource.data.slotId is string
        && slotIdMatches(request.resource.data.slotId, request.resource.data.doctorId, request.resource.data.startAt)
        && request.resource.data.quotaPlace in [1, 2, 3]
        && doctorAllows(request.resource.data)
        && getAfter(lockPath(request.resource.data.slotId)).data.bookingId == bookingId
        && getAfter(quotaPath(request.auth.uid, request.resource.data.quotaPlace)).data.bookingId == bookingId;

      // Cancelling, before it starts: only status, cancelledAt and cancelledBy change, and the slot
      // lock goes in the same write so the slot frees up. The patient cancels their own
      // ("patient"); an admin cancels for the clinic ("clinic") and must free the patient's quota
      // place too. Nobody un-cancels.
      allow update: if isSignedIn()
        && resource.data.status == 'booked'
        && request.time < resource.data.startAt
        && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && !existsAfter(lockPath(resource.data.slotId))
        && ((resource.data.patientUid == request.auth.uid
            && request.resource.data.cancelledBy == 'patient')
          || (request.resource.data.cancelledBy == 'clinic'
            && emailVerified()
            && isAdmin()
            && !holdsAfter(resource.data.patientUid, resource.data.quotaPlace, bookingId)));

      // History stays: no client deletes a booking.
      allow delete: if false;
    }

    match /slotLocks/{slotId} {
      // Signed-in users see which slots are taken. Locks hold no personal data.
      allow read: if isSignedIn();

      // Only together with the new booking it points to (create, never overwrite: a taken
      // slot is an update, which is denied).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['doctorId', 'startAt', 'bookingId'])
        && request.resource.data.keys().hasAll(['doctorId', 'startAt', 'bookingId'])
        && isAutoId(request.resource.data.bookingId)
        && !exists(bookingPath(request.resource.data.bookingId))
        && getAfter(bookingPath(request.resource.data.bookingId)).data.patientUid == request.auth.uid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status == 'booked'
        && getAfter(bookingPath(request.resource.data.bookingId)).data.slotId == slotId
        && getAfter(bookingPath(request.resource.data.bookingId)).data.doctorId == request.resource.data.doctorId
        && getAfter(bookingPath(request.resource.data.bookingId)).data.startAt == request.resource.data.startAt;

      // Only when its booking is cancelled in the same write: by its patient, or by an admin
      // for the clinic (then only the lock that booking names).
      allow delete: if isSignedIn()
        && ((getAfter(bookingPath(resource.data.bookingId)).data.patientUid == request.auth.uid
            && getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled')
          || (isClinicCancelling(resource.data.bookingId)
            && get(bookingPath(resource.data.bookingId)).data.slotId == slotId));

      allow update: if false;
    }

    // The 3 places that cap a patient at 3 upcoming bookings. A place holds a booking until
    // that booking starts (then it may be reused) or is cancelled (then it is freed).
    match /users/{uid}/bookingQuota/{place} {
      function holdsNewBooking() {
        let booking = getAfter(bookingPath(request.resource.data.bookingId)).data;
        return request.resource.data.keys().hasOnly(['bookingId', 'startAt'])
          && request.resource.data.keys().hasAll(['bookingId', 'startAt'])
          && isAutoId(request.resource.data.bookingId)
          && !exists(bookingPath(request.resource.data.bookingId))
          && booking.patientUid == uid
          && booking.status == 'booked'
          && booking.quotaPlace == int(place)
          && booking.startAt == request.resource.data.startAt;
      }

      // Admins may read one place (not list them) to see whether it holds a booking they cancel.
      allow read: if isOwner(uid);
      allow get: if isAdmin();
      allow create: if isOwner(uid) && place in ['1', '2', '3'] && holdsNewBooking();
      allow update: if isOwner(uid) && resource.data.startAt <= request.time && holdsNewBooking();
      // The owner frees a place once its booking has started or is cancelled. An admin frees
      // only the place of the booking they are cancelling for the clinic in the same write.
      allow delete: if (isOwner(uid)
          && (resource.data.startAt <= request.time
            || getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled'))
        || (isSignedIn()
          && isClinicCancelling(resource.data.bookingId)
          && get(bookingPath(resource.data.bookingId)).data.patientUid == uid
          && string(get(bookingPath(resource.data.bookingId)).data.quotaPlace) == place);
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
