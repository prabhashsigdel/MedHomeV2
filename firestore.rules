rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasValidName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
    }

    // Optional profile fields: each may be absent; if present it must be well formed.
    // Must match Validators.normalizePhone (Nepali mobile: 10 digits starting 96, 97 or 98).
    function hasValidPhone() {
      return !('phone' in request.resource.data)
        || (request.resource.data.phone is string
          && request.resource.data.phone.matches('9[678][0-9]{8}'));
    }

    // ISO calendar date "YYYY-MM-DD" (BirthDate in the app).
    function hasValidDateOfBirth() {
      return !('dateOfBirth' in request.resource.data)
        || (request.resource.data.dateOfBirth is string
          && request.resource.data.dateOfBirth.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // Stored as a fixed key, never as translated text.
    function hasValidGender() {
      return !('gender' in request.resource.data)
        || request.resource.data.gender in ['male', 'female', 'other'];
    }

    match /users/{uid} {
      // Own document, or any document for admins. isOwner is checked first to skip the get().
      allow read: if isOwner(uid) || isAdmin();

      // Self-signup always creates a patient. createdAt must be the server timestamp.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && hasValidName()
        // Lowercased on both sides so a difference in letter case can't block profile creation.
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'patient'
        && request.resource.data.createdAt == request.time;

      // Owners may edit (or clear) name, phone, date of birth and gender, nothing else: never
      // their role, email or creation time. Admins may change only the role, to a known value.
      allow update: if (isOwner(uid)
          && changedKeys().hasOnly(['name', 'phone', 'dateOfBirth', 'gender'])
          && hasValidName()
          && hasValidPhone()
          && hasValidDateOfBirth()
          && hasValidGender())
        || (isAdmin()
          && changedKeys().hasOnly(['role'])
          && request.resource.data.role in ['patient', 'doctor', 'admin']);

      // Needed for in-app account deletion.
      allow delete: if isOwner(uid);
    }

    // The doctors catalogue: signed-in users may read active doctors (a list must ask for
    // active == true); admins may read every doctor. No client may write it: it is maintained
    // with the Admin SDK (tools/seed), which bypasses these rules. isAdmin() is only evaluated
    // for inactive or missing doctors, so ordinary reads cost no extra document read.
    match /doctors/{doctorId} {
      allow read: if isSignedIn() && (resource.data.active == true || isAdmin());
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
