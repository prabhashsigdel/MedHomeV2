{
  "name": "medhome-rules-tests",
  "private": true,
  "description": "Firestore security rules tests, run against the local emulator.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --config ../../firebase.json --only firestore --project demo-medhome \"mocha --timeout 20000 test/\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "mocha": "12.0.3"
  }
}
